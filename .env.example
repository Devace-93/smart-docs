# Smart Docs environment. Copy to .env and edit. Every variable has one line on why it exists.

# --- Instance ---
INSTANCE_NAME=Smart Docs                       # shown in titles and the API spec
PUBLIC_BASE_URL=http://localhost:8000          # used to build public URLs and MCP instructions
SIGNUPS_OPEN=true                              # false stops new 3m4 accounts from getting a Smart Docs account here
FOOTER_TEXT=Built with Smart Docs              # the polite ask on public pages; empty string removes it
FOOTER_URL=https://github.com/Devace-93/smart-docs
INFO_URL=https://info.3m4.net                  # "More apps" footer link

# --- Database (pgvector image, see docker-compose.yml) ---
DATABASE_URL=postgresql+psycopg://sd:sd@db:5432/sd
POSTGRES_USER=sd
POSTGRES_PASSWORD=sd
POSTGRES_DB=sd

# --- Auth (SD-014: identity lives at accounts.3m4.net) ---
ACCOUNTS_URL=http://localhost:8085             # the accounts service: JWT issuer, login/signup redirects, browser calls
ACCOUNTS_INTERNAL_URL=                         # where the api fetches the JWKS; empty = ACCOUNTS_URL (compose sets the edge address)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=                                    # required only for the BYOK tier (encrypts user keys at rest)

# --- Model tiers (SD-005). A fresh clone runs local only. ---
DEFAULT_TIER=local                             # tier for new accounts: local | hosted | byok | agent
LOCAL_ENABLED=true                             # Ollama; `docker compose --profile local` starts it
OLLAMA_URL=http://ollama:11434
LOCAL_MODEL=qwen2.5:3b                         # summaries and tags; qwen2.5:1.5b or 0.5b on small servers
LOCAL_PER_10S=1                                # per account
LOCAL_PER_HOUR=20                              # per account
EMBED_MODEL=nomic-embed-text                   # always local, 768 dims, one vector space for every tier
HOSTED_ENABLED=false                           # the operator pays; needs HOSTED_API_KEY
HOSTED_BASE_URL=https://api.deepseek.com
HOSTED_API_KEY=
HOSTED_MODEL=deepseek-chat
HOSTED_DAILY_LIMIT=30                          # requests per account per day, resets 00:00 UTC
BYOK_ENABLED=true                              # users bring an OpenAI-compatible endpoint; needs FERNET_KEY
MODEL_TIMEOUT_SECONDS=120

# --- Public pages ---
PUBLIC_CACHE_SECONDS=300                       # Cache-Control max-age on public routes

# --- Compose ---
SD_PORT=8000                                   # host port for the api service

# retro feedback widget (https://retro.3m4.net): the project's PUBLIC key. Empty = no widget.
RETRO_PROJECT_KEY=
RETRO_WIDGET_URL=https://retro.3m4.net/widget.js
# metrics web analytics (https://metrics.3m4.net): the project's PUBLIC key. Empty = no tracker.
METRICS_PROJECT_KEY=
METRICS_TRACKER_URL=https://metrics.3m4.net/m.js
# oops error tracking (https://oops.3m4.net): the project's PUBLIC key. Empty = no SDK.
OOPS_PROJECT_KEY=
OOPS_SDK_URL=https://oops.3m4.net/o.js
